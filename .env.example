# Token de GitHub con permisos en el repo de builds:
#   Actions: Read/write + Contents: Read/write
# Genera uno en: https://github.com/settings/tokens (fine-grained) u https://github.com/settings/tokens/new (classic)
GITHUB_TOKEN=

# Repo donde se suben los proyectos y corren los builds. Ej: tunombre/inteebuild-builds
INTEE_BUILDS_REPO=

# Rama base (opcional). Por defecto: main
INTEE_DEFAULT_BRANCH=main

# Puerto del server (opcional). Por defecto: 8787
PORT=8787

# Origen permitido para CORS en producción (opcional).
# Si lo dejas vacío se permiten todos los orígenes (solo para desarrollo).
# Ejemplo: CORS_ORIGIN=https://tu-dominio.com
CORS_ORIGIN=

# Secreto para activar la limpieza manual vía GET /api/cleanup?secret=...
# Si lo dejas vacío, la limpieza manual queda DESACTIVADA (recomendado).
# La limpieza automática cada 30 min sigue funcionando igual.
CLEANUP_SECRET=