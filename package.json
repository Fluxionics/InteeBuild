{
  "name": "inteebuild",
  "version": "4.2.0",
  "description": "Convierte tu web o HTML en APK/AAB nativo con permisos Android granulares, audio nativo, 2 providers WebView listos, splash screen, historial de builds y configuracion completa.",
  "main": "server/server.js",
  "bin": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test tests/permissions.test.js tests/generator.test.js",
    "i18n:extract": "node i18n/extract.js && node i18n/group.js && node i18n/validate.js",
    "i18n:cov": "node scripts/cov-all.js",
    "check": "node scripts/comment-audit.js && node scripts/wf-check.js && node scripts/devhtml-check.js && node scripts/cov-all.js && node i18n/validate.js",
    "check:routes": "node scripts/smoke-routes.js",
    "check:smoke": "node scripts/smoke-i18n.js",
    "build:binary": "pkg . --out-path dist/bin"
  },
  "pkg": {
    "targets": [
      "node22-linux-x64",
      "node22-macos-x64",
      "node22-win-x64"
    ],
    "assets": [
      "index.html",
      "about.html",
      "docs.html",
      "developer.html",
      "historial.html",
      "license.html",
      "privacy.html",
      "terms.html",
      "robots.txt",
      "sitemap.xml",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "i18n/**/*",
      "docs/**/*"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "js-yaml": "^5.4.2"
  }
}
