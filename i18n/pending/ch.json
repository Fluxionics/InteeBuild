    "import requests, time base = \"https://TU_DOMINIO\" key = \"ib_xxx\" r = requests.post(f\"{base}/api/v1/build\", headers={\"X-API-Key\": key}, json={\"url\": \"https://example.com\", \"name\": \"MiApp\", \"output\": \"apk\"}) bid = r.json()[\"buildId\"] while True: s = requests.get(f\"{base}/api/v1/build/{bid}\", headers={\"X-API-Key\": key}).json() print(s[\"status\"], s.get(\"step\")) if s[\"status\"] not in (\"queued\", \"building\"): break time.sleep(3) if s[\"status\"] == \"success\": open(\"app.apk\", \"wb\").write(requests.get(base + s[\"apkUrl\"]).content)": "import requests, time base = \"https://TU_DOMINIO\" key = \"ib_xxx\" r = requests.post(f\"{base}/api/v1/build\", headers={\"X-API-Key\": key}, json={\"url\": \"https://example.com\", \"name\": \"MiApp\", \"output\": \"apk\"}) bid = r.json()[\"buildId\"] while True: s = requests.get(f\"{base}/api/v1/build/{bid}\", headers={\"X-API-Key\": key}).json() print(s[\"status\"], s.get(\"step\")) if s[\"status\"] not in (\"queued\", \"building\"): break time.sleep(3) if s[\"status\"] == \"success\": open(\"app.apk\", \"wb\").write(requests.get(base + s[\"apkUrl\"]).content)",
